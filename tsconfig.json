{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // El visor 3D se compila aparte: @react-three/fiber amplia el JSX
    // global de React (declare module 'react') y sus cientos de elementos
    // 3D hacen que las props comunes de React.ElementType colapsen a
    // `never`, rompiendo <Icon className/> en TODO el proyecto. Se carga
    // con next/dynamic, asi que Next lo compila igual en tiempo de build.
    "components/estudio-3d/visor/**"
  ]
}
